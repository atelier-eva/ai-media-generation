{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.spec/animagine-lora-training/characters.schema.json",
  "title": "Character (animagine-lora-training/characters/*.json)",
  "description": "One character per JSON file under animagine-lora-training/characters/. Tag definitions for generated prompts.",
  "type": "object",
  "additionalProperties": false,
  "required": ["name"],
  "properties": {
    "name": {
      "type": "string",
      "minLength": 1,
      "description": "Display name used in filename_prefix and caption_prompt"
    },
    "subject": {
      "oneOf": [
        { "type": "string", "minLength": 1 },
        { "$ref": "#/$defs/tags" }
      ],
      "description": "Subject tags emitted first in positive_prompt and immediately after name in caption_prompt (e.g. 1girl)"
    },
    "positive": {
      "type": "array",
      "items": {
        "oneOf": [
          { "type": "string", "minLength": 1 },
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["tag"],
            "properties": {
              "tag": {
                "type": "string",
                "minLength": 1
              },
              "weight": {
                "type": "number",
                "exclusiveMinimum": 0,
                "description": "Attention weight for positive_prompt only (emitted as (tag:weight)); caption_prompt uses the bare tag"
              },
              "skip_camera": {
                "$ref": "#/$defs/skip_camera",
                "description": "When angle or distance name matches (OR), this tag is omitted."
              }
            }
          }
        ]
      }
    },
    "negative": { "$ref": "#/$defs/tags" }
  },
  "examples": [
    {
      "name": "character",
      "subject": "1girl",
      "positive": ["blonde hair", "blue eyes"],
      "negative": []
    }
  ],
  "$defs": {
    "tags": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "skip_camera": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "angle": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "description": "camera.angle[].name values in camera.json"
        },
        "distance": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "description": "camera.distance[].name values in camera.json"
        }
      }
    }
  }
}
