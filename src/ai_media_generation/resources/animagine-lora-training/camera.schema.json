{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.spec/animagine-lora-training/camera.schema.json",
  "title": "Camera (animagine-lora-training/camera.json)",
  "description": "Camera angle and distance tag definitions for generated prompts.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "angle": {
      "type": "array",
      "items": { "$ref": "#/$defs/named_tag_set" }
    },
    "distance": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "image_size"],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "description": "Stable identifier; used in filename_prefix. When positive is omitted or empty, name is the sole positive tag."
          },
          "positive": { "$ref": "#/$defs/tags" },
          "negative": { "$ref": "#/$defs/tags" },
          "image_size": {
            "type": "object",
            "additionalProperties": false,
            "required": ["width", "height"],
            "properties": {
              "width": { "$ref": "#/$defs/image_dimension" },
              "height": { "$ref": "#/$defs/image_dimension" }
            },
            "description": "Output dimensions for this camera distance (width x height). Animagine XL 4: each side must be a multiple of 64 and at most 1536."
          }
        }
      }
    }
  },
  "$defs": {
    "image_dimension": {
      "type": "integer",
      "minimum": 64,
      "maximum": 1536,
      "multipleOf": 64,
      "description": "Animagine XL 4 pixel length. Multiple of 64, at most 1536 (recommended range)."
    },
    "tags": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "named_tag_set": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "description": "Stable identifier; used in filename_prefix. When positive is omitted or empty, name is the sole positive tag."
        },
        "positive": { "$ref": "#/$defs/tags" },
        "negative": { "$ref": "#/$defs/tags" }
      }
    }
  }
}
