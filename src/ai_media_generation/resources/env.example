# Shared ComfyUI (--listen default).
COMFY_UI_URL=http://127.0.0.1:8188

# animagine-lora-training
# Spec JSON (art-style.json, characters/, ...). Defaults to animagine-lora-training when unset.
ANIMAGINE_LORA_TRAINING_SPEC_DIRECTORY=animagine-lora-training
# Filename prefix for image saves (slug + row + tags). Defaults to animagine-lora when unset.
ANIMAGINE_LORA_FILENAME_PREFIX=animagine-lora
# Dataset (images, captions, jsonl) and report (patterns.csv). Defaults to animagine-lora-dataset when unset.
ANIMAGINE_LORA_DATASET_DIRECTORY=animagine-lora-dataset

# animagine
# Spec JSON. Nested folders allowed. Defaults to prompt when unset.
ANIMAGINE_SPEC_DIRECTORY=prompt
# Checkpoint for animagine and animagine-lora-training. Filename in ComfyUI's models/checkpoints.
ANIMAGINE_CKPT_NAME=animagine-xl-4.0-opt.safetensors
# Output. Defaults to image-output when unset.
ANIMAGINE_OUTPUT_DIRECTORY=image-output

# qwen
# Spec JSON. Nested folders allowed. Defaults to qwen when unset.
QWEN_SPEC_DIRECTORY=qwen
# Output. Defaults to qwen-output when unset.
QWEN_OUTPUT_DIRECTORY=qwen-output
# Seconds to wait for ComfyUI jobs. Defaults to 1800 when unset.
QWEN_TIMEOUT_SECONDS=1800
# qwen-lora-training spec JSON (art-style.json, characters/, ...). Defaults to qwen-lora-training when unset.
QWEN_LORA_TRAINING_SPEC_DIRECTORY=qwen-lora-training
# Filename prefix for image saves (slug + row + names).
QWEN_LORA_FILENAME_PREFIX=qwen-lora
# Dataset (images, captions, jsonl). Defaults to qwen-lora-dataset when unset.
QWEN_LORA_DATASET_DIRECTORY=qwen-lora-dataset
# Seconds to wait for ComfyUI jobs. Defaults to 1800 when unset.
QWEN_LORA_TIMEOUT_SECONDS=1800

# kagee
# Spec JSON. Nested folders allowed. Defaults to kagee when unset.
KAGEE_SPEC_DIRECTORY=kagee
# Output. Defaults to kagee-output when unset.
KAGEE_OUTPUT_DIRECTORY=kagee-output
# Seconds to wait for ComfyUI jobs. Defaults to 1800 when unset.
KAGEE_TIMEOUT_SECONDS=1800

# music
# ACE-Step REST API base URL. Leave empty when the API is not running.
ACE_STEP_URL=http://127.0.0.1:8001
# ACE-Step API key. Leave empty when the server has no ACESTEP_API_KEY.
ACE_STEP_API_KEY=
# Prefix for saved audio filenames. Spec id is appended.
ACE_STEP_FILENAME_PREFIX=music
# Spec JSON. Defaults to music when unset.
MUSIC_SPEC_DIRECTORY=music
# Output. Defaults to music-output when unset.
MUSIC_OUTPUT_DIRECTORY=music-output
