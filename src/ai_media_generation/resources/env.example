# ACE-Step REST API base URL. Leave empty when the API is not running.
ACE_STEP_URL=http://127.0.0.1:8001

# ACE-Step API key. Leave empty when the server has no ACESTEP_API_KEY.
ACE_STEP_API_KEY=

# Prefix for saved audio filenames. Spec id is appended.
ACE_STEP_FILENAME_PREFIX=music

# LoRA training JSON (art-style.json, characters/, ...).
# Defaults to lora-training when unset.
LORA_TRAINING_DIRECTORY=lora-training

# Prompt JSON for animagine. Nested folders allowed.
# Defaults to prompt when unset.
PROMPT_DIRECTORY=prompt

# Music JSON for music.
# Defaults to music when unset.
MUSIC_DIRECTORY=music

# Kagee JSON for kagee. Nested folders allowed.
# Defaults to kagee when unset.
KAGEE_DIRECTORY=kagee

# Qwen JSON for qwen. Nested folders allowed.
# Defaults to qwen when unset.
QWEN_DIRECTORY=qwen

# ComfyUI base URL (--listen default).
COMFY_UI_URL=http://127.0.0.1:8188

# Checkpoint filename in ComfyUI's models/checkpoints directory.
COMFY_UI_CKPT_NAME=animagine-xl-4.0-opt.safetensors

# Filename prefix for lora-training image saves (slug + row + tags).
# Not used by animagine (that uses the prompt id path as-is).
COMFY_UI_FILENAME_PREFIX=lora

# Output for animagine.
# Defaults to image-output when unset.
IMAGE_OUTPUT_DIRECTORY=image-output

# Output for music.
# Defaults to music-output when unset.
MUSIC_OUTPUT_DIRECTORY=music-output

# Output for kagee.
# Defaults to kagee-output when unset.
KAGEE_OUTPUT_DIRECTORY=kagee-output

# Seconds to wait for kagee ComfyUI jobs. Defaults to 1800 when unset.
KAGEE_TIMEOUT_SECONDS=1800

# Output for qwen.
# Defaults to qwen-output when unset.
QWEN_OUTPUT_DIRECTORY=qwen-output

# Seconds to wait for qwen ComfyUI jobs. Defaults to 1800 when unset.
QWEN_TIMEOUT_SECONDS=1800

# Dataset for lora-training (images, captions, jsonl) and report (patterns.csv).
# Defaults to lora-dataset when unset.
LORA_DATASET_DIRECTORY=lora-dataset
