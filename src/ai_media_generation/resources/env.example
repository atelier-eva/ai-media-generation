# Shared ComfyUI (--listen default).
COMFY_UI_URL=http://127.0.0.1:8188

# RunPod REST API v2 (pod-status, pod-start, pod-stop, pod-connect, qwen --remote, kagee --remote). Console Settings > API Keys.
RUNPOD_API_KEY=
# Existing pod id. Direct SSH is listed only while the pod is running and 22/tcp is exposed.
RUNPOD_POD_ID=
# Seconds to wait for RUNNING, EXITED, or ComfyUI after the tunnel is up. Defaults to 600 when unset.
RUNPOD_TIMEOUT_SECONDS=600
# Optional SSH private key for Direct SSH. Unset uses ssh default identities.
RUNPOD_SSH_IDENTITY=
# ComfyUI directory on the RunPod pod, not on this machine. Defaults to
# /workspace/runpod-slim/ComfyUI when unset.
RUNPOD_COMFYUI_ROOT=/workspace/runpod-slim/ComfyUI

# animagine-lora-training
# Spec JSON (art-style.json, characters/, ...). Defaults to animagine/lora_dataset when unset.
ANIMAGINE_LORA_TRAINING_SPEC_DIRECTORY=animagine/lora_dataset
# Filename prefix for image saves (slug + row + tags). Defaults to animagine-lora when unset.
ANIMAGINE_LORA_FILENAME_PREFIX=animagine-lora
# Dataset (images, captions, jsonl) and report (patterns.csv). Defaults to animagine/lora_output when unset.
ANIMAGINE_LORA_DATASET_DIRECTORY=animagine/lora_output

# animagine
# Spec JSON. Nested folders allowed. Defaults to animagine/spec when unset.
ANIMAGINE_SPEC_DIRECTORY=animagine/spec
# Checkpoint for animagine and animagine-lora-training. Filename in ComfyUI's models/checkpoints.
ANIMAGINE_CKPT_NAME=animagine-xl-4.0-opt.safetensors
# Output. Defaults to animagine/output when unset.
ANIMAGINE_OUTPUT_DIRECTORY=animagine/output

# qwen
# Spec JSON. Nested folders allowed. Defaults to qwen/spec when unset.
QWEN_SPEC_DIRECTORY=qwen/spec
# Output. Defaults to qwen/output when unset.
QWEN_OUTPUT_DIRECTORY=qwen/output
# Seconds to wait for ComfyUI jobs. Defaults to 1800 when unset.
QWEN_TIMEOUT_SECONDS=1800
# qwen-edit spec JSON. Nested folders allowed. Defaults to qwen/edit/spec when unset.
QWEN_EDIT_SPEC_DIRECTORY=qwen/edit/spec
# Output. Defaults to qwen/edit/output when unset.
QWEN_EDIT_OUTPUT_DIRECTORY=qwen/edit/output
# Seconds to wait for ComfyUI jobs. Defaults to 1800 when unset.
QWEN_EDIT_TIMEOUT_SECONDS=1800
# qwen-lora-training spec JSON (art-style.json, characters/, ...). Defaults to qwen/lora_dataset when unset.
QWEN_LORA_TRAINING_SPEC_DIRECTORY=qwen/lora_dataset
# Filename prefix for image saves (slug + row + names).
QWEN_LORA_FILENAME_PREFIX=qwen-lora
# Dataset (images, captions, jsonl). Defaults to qwen/lora_output when unset.
QWEN_LORA_DATASET_DIRECTORY=qwen/lora_output
# Seconds to wait for ComfyUI jobs. Defaults to 1800 when unset.
QWEN_LORA_TIMEOUT_SECONDS=1800

# anima
# Spec JSON. Nested folders allowed. Defaults to anima/spec when unset.
ANIMA_SPEC_DIRECTORY=anima/spec
# Output. Defaults to anima/output when unset.
ANIMA_OUTPUT_DIRECTORY=anima/output
# Seconds to wait for ComfyUI jobs. Defaults to 1800 when unset.
ANIMA_TIMEOUT_SECONDS=1800

# kagee
# Spec JSON. Nested folders allowed. Defaults to kagee when unset.
KAGEE_SPEC_DIRECTORY=kagee
# Output. Defaults to kagee-output when unset.
KAGEE_OUTPUT_DIRECTORY=kagee-output
# Seconds to wait for ComfyUI jobs. Defaults to 1800 when unset.
KAGEE_TIMEOUT_SECONDS=1800

# music
# ACE-Step REST API base URL. Leave empty when the API is not running.
ACE_STEP_URL=http://127.0.0.1:8001
# ACE-Step API key. Leave empty when the server has no ACESTEP_API_KEY.
ACE_STEP_API_KEY=
# Prefix for saved audio filenames. Spec id is appended.
ACE_STEP_FILENAME_PREFIX=music
# Spec JSON. Defaults to music when unset.
MUSIC_SPEC_DIRECTORY=music
# Output. Defaults to music-output when unset.
MUSIC_OUTPUT_DIRECTORY=music-output
