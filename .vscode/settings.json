{
  "files.eol": "\n",
  "files.exclude": {
    "**/__pycache__": true,
    "**/*.py[cod]": true,
    "**/*.egg-info": true,
    "**/.mypy_cache": true,
    "**/.pytest_cache": true,
    "**/.ruff_cache": true,
    ".venv": true
  },
  "files.watcherExclude": {
    "**/__pycache__/**": true,
    "**/.venv/**": true
  },
  "json.schemas": [
    {
      "fileMatch": ["**/animagine-lora-training/art-style.json"],
      "url": "./src/ai_media_generation/resources/animagine-lora-training/art-style.schema.json"
    },
    {
      "fileMatch": ["**/animagine-lora-training/camera.json"],
      "url": "./src/ai_media_generation/resources/animagine-lora-training/camera.schema.json"
    },
    {
      "fileMatch": ["**/animagine-lora-training/characters/*.json"],
      "url": "./src/ai_media_generation/resources/animagine-lora-training/characters.schema.json"
    },
    {
      "fileMatch": ["**/animagine-lora-training/expression.json"],
      "url": "./src/ai_media_generation/resources/animagine-lora-training/expression.schema.json"
    },
    {
      "fileMatch": ["**/animagine-lora-training/generation.json"],
      "url": "./src/ai_media_generation/resources/animagine-lora-training/generation.schema.json"
    },
    {
      "fileMatch": ["**/animagine-lora-training/pose.json"],
      "url": "./src/ai_media_generation/resources/animagine-lora-training/pose.schema.json"
    },
    {
      "fileMatch": ["**/animagine-lora-training/scene.json"],
      "url": "./src/ai_media_generation/resources/animagine-lora-training/scene.schema.json"
    },
    {
      "fileMatch": ["**/qwen-lora-training/art-style.json"],
      "url": "./src/ai_media_generation/resources/qwen-lora-training/art-style.schema.json"
    },
    {
      "fileMatch": ["**/qwen-lora-training/camera.json"],
      "url": "./src/ai_media_generation/resources/qwen-lora-training/camera.schema.json"
    },
    {
      "fileMatch": ["**/qwen-lora-training/characters/*.json"],
      "url": "./src/ai_media_generation/resources/qwen-lora-training/characters.schema.json"
    },
    {
      "fileMatch": ["**/qwen-lora-training/expression.json"],
      "url": "./src/ai_media_generation/resources/qwen-lora-training/expression.schema.json"
    },
    {
      "fileMatch": ["**/qwen-lora-training/generation.json"],
      "url": "./src/ai_media_generation/resources/qwen-lora-training/generation.schema.json"
    },
    {
      "fileMatch": ["**/qwen-lora-training/pose.json"],
      "url": "./src/ai_media_generation/resources/qwen-lora-training/pose.schema.json"
    },
    {
      "fileMatch": ["**/qwen-lora-training/scene.json"],
      "url": "./src/ai_media_generation/resources/qwen-lora-training/scene.schema.json"
    },
    {
      "fileMatch": ["**/prompt/*.json", "**/prompt/**/*.json"],
      "url": "./src/ai_media_generation/resources/prompt.schema.json"
    },
    {
      "fileMatch": ["**/qwen/*.json", "**/qwen/**/*.json"],
      "url": "./src/ai_media_generation/resources/qwen.schema.json"
    },
    {
      "fileMatch": ["**/music/*.json"],
      "url": "./src/ai_media_generation/resources/music.schema.json"
    }
  ],
  "search.exclude": {
    "**/.venv": true
  }
}
